{
  "description": "Ledger-backed enforcement: gates spawns, writes, and shell use; stamps agent identity on ledger calls; tracks the agent registry; and keeps the Oracle session going while work remains.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks session_start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks pre_agent",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks pre_write",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks pre_shell",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__plugin_sentinel-swarm_swarm-ledger__.*|mcp__swarm-ledger__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks pre_ledger",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "sentinel-swarm:oracle|sentinel-swarm:manager|sentinel-swarm:lead|sentinel-swarm:coder|oracle|manager|lead|coder",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks subagent_start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks post_any",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks post_shell",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks pre_compact",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "sentinel-swarm:oracle|sentinel-swarm:manager|sentinel-swarm:lead|sentinel-swarm:coder|oracle|manager|lead|coder",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks subagent_stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/mcp\" --frozen --no-dev python -m swarm_ledger.hooks session_end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
