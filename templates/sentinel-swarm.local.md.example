---
# Tracking backend for the ledger. `local` is the only value for now; other
# trackers (GitHub issues, Jira) may become values later.
tracking: local

# How the role hooks run: mod (the plugin's mod) or command (the role files'
# command hooks). Leave it empty and setup picks mod on Claude Code 2.1.294 or later.
hook_transport:

runtime:
  # Every role runs as its own Claude Code session in the one working tree. A parent
  # starts a child with the ledger's agent_spawn tool. The Oracle starts a Driver with
  # drive_request instead; the Driver exists only when the host has cartographer and a
  # driver plugin installed.
  oracle: session
  manager: session
  lead: session
  coder: session
  driver: session

models:
  # Approved models for the Oracle. It has no parent, so it runs on the first
  # entry, opus.
  oracle: [opus, fable]
  # Approved models for the Manager.
  manager: [opus]
  # Approved models for the Lead.
  lead: [opus, sonnet]
  # Approved models for the Coder.
  coder: [sonnet, haiku]
  # Approved models for the Driver. drive_request runs it on the first entry, sonnet.
  driver: [sonnet, opus]

rubric:
  # The goal for every scored dimension.
  target: 90
  # No file passes with a dimension below this.
  floor: 70
  # No file passes with a criterion rated below this.
  criterion_floor: 5
  # Two reviews that differ by this much on a dimension are "not agreed".
  disagreement_gap: 10
  # A gain smaller than this, on a dimension a fix targeted, is a plateau.
  plateau: 2
  # A drop of this much on any dimension makes a fix "significantly worse".
  regression_tolerance: 5

escalation:
  # Number of escalation rounds before the Oracle decides to change the plan or
  # notify the user.
  rounds: 3
  # Non-improving attempts per round before the issue moves to the next round.
  attempts_per_round: 3

watchdog:
  # Seconds between two checks. The watchdog runs inside the ledger server.
  interval_seconds: 30
  # A working agent with no activity for this many minutes is reported as stuck.
  stuck_minutes: 15
  # This many failed test runs in a row, for the same scope and target, is spinning.
  spin_failures: 5
  # An agent whose latest request fills this percent of its context window is reported.
  context_pct: 80
  # The context window in tokens. Leave it unset to take it from the model: 1000000 for
  # Sonnet, Opus, and Fable, 200000 for Haiku. A value here applies to every session.
  # context_window: 1000000
  # The ledger server exits after this many minutes with no active run, or a paused
  # run, and no session of the run running.
  idle_exit_minutes: 15

# Left empty; the setup skill fills this in from the plugin's test_command option, set
# at install, or else the detected stack.
test_command:
# Left empty; the setup skill fills this in from the detected stack.
build_command:
# Left empty; the setup skill fills this in from the detected stack.
lint_command:

# Left empty; no default parallelism cap is set yet.
parallelism_cap:

# Left empty; no time budget. Minutes the run should take. Each wake-up and watchdog line
# for the Oracle or a Manager then ends with "elapsed <n>s / <budget>s" instead of
# "elapsed <n>s". The budget is advisory: nothing stops the run at the limit.
time_budget_minutes:

# Left empty; repo_check then tries main, then master, then reports no base branch.
base_branch:

# How the user hears that the Driver finished or hit an error. os: the ledger server shows a
# desktop notification itself (a Windows toast, macOS Notification Center, or notify-send on
# Linux). push: the Oracle owes a PushNotification call, and its Stop hook blocks until it
# makes one. An empty list, [], turns both off.
notify: [os, push]

# agent_spawn and the launcher pass --effort <level> for a role listed here; a brief's own
# effort overrides it. Values are Claude Code's own: low, medium, high, xhigh, max. medium
# is the documented starting point for Opus 5.5 and for well-specified agentic coding on
# Sonnet 5.5. Leave a role empty to run at its model's default.
effort:
  oracle: medium
  manager: medium
  lead: medium
  coder: medium
  driver: medium

# agent_spawn sets promptCacheTtl for a role listed here. Claude Code accepts only "5m" or
# "1h" and otherwise ignores the value. A Coder lives a few minutes, so a 5-minute cache
# write, at 1.25x base input, costs less than a 1-hour write at 2x.
prompt_cache_ttl:
  oracle:
  manager:
  lead:
  coder: 5m
  driver:

# Left empty for every role; agent_spawn also caps that role's own live sessions in the run,
# on top of parallelism_cap above.
role_parallelism_cap:
  oracle:
  manager:
  lead:
  coder:
  driver:

# Worker processes that run the ledger's tool calls and hooks. The server starts one when a
# call finds none free, up to this many, and stops one after 60 seconds idle. 0 runs every
# call in the server process, one at a time.
max_workers: 8
---

# sentinel-swarm local settings

This file goes at `.claude/sentinel-swarm.local.md` in the host repo, the repo the
swarm builds in. Copy this example to that path and edit the frontmatter above.

The file is not committed. It holds per-project and per-developer settings for the
ledger, not project source, so the swarm's own tooling keeps it out of the host
repo's history.
